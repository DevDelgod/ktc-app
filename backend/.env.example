# Caminho do JSON da conta de serviço do Firebase Admin.
# Deixe vazio em produção para usar Application Default Credentials.
# NUNCA versione o arquivo apontado aqui.
FIREBASE_CREDENTIALS=./chave-firebase.json

# ID do projeto no Firebase. Opcional quando a credencial já o contém.
FIREBASE_PROJECT_ID=kafutirocert0

# Origens autorizadas a chamar a API, separadas por vírgula.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Segundos que os treinos ficam em cache antes de reler o Firestore.
CACHE_TTL=60

# 1 para servir o frontend pelo próprio backend, 0 para servir só a API.
SERVE_FRONTEND=1

AMBIENTE=desenvolvimento
